# RZ Quran Kids — local development environment template.
# Copy to .env for local runs. Never commit real secrets; never use VITE_ for secrets.

APP_ENV=development
APP_ORIGIN=http://localhost:5173
API_PORT=3000
DATABASE_URL=postgresql://rzq:local_only@127.0.0.1:5433/quran_kids

# Better Auth (adult accounts only)
AUTH_SECRET=replace_with_generated_local_secret
AUTH_BASE_URL=http://localhost:5173

# Email delivery. Empty in local dev => verification links are logged to the
# server console only (honest local stub, never a fake delivery claim).
MAIL_FROM=
SMTP_URL=

# S3-compatible private storage (media; unused by the M1 slice)
STORAGE_ENDPOINT=
STORAGE_REGION=
STORAGE_BUCKET_PRIVATE=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=

# Content provider (unused in M1; fixtures only)
CONTENT_PROVIDER=fixture
QF_CLIENT_ID=
QF_CLIENT_SECRET=
QF_ENV=prelive

# Safety switches. Production boot must refuse DEMO_MODE=true and must keep
# child enrollment disabled until approved policy versions are configured.
DEMO_MODE=true
PRODUCTION_CHILD_ENROLLMENT_ENABLED=false
APPROVED_PRIVACY_POLICY_VERSION=
APPROVED_CONSENT_METHOD=
