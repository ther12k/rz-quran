{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/rz-quran-kids/progress-event.schema.json",
  "title": "Client learning event; server validates session context and ordered sequence",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "event_id": {
          "type": "string",
          "format": "uuid"
        },
        "sequence": {
          "type": "integer",
          "minimum": 1
        },
        "client_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "type": {
          "const": "unit_acknowledged"
        },
        "unit_id": {
          "type": "string",
          "format": "uuid"
        }
      },
      "required": [
        "event_id",
        "sequence",
        "client_at",
        "type",
        "unit_id"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "event_id": {
          "type": "string",
          "format": "uuid"
        },
        "sequence": {
          "type": "integer",
          "minimum": 1
        },
        "client_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "type": {
          "const": "heartbeat"
        },
        "active_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 15000
        }
      },
      "required": [
        "event_id",
        "sequence",
        "client_at",
        "type",
        "active_ms"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "event_id": {
          "type": "string",
          "format": "uuid"
        },
        "sequence": {
          "type": "integer",
          "minimum": 1
        },
        "client_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "type": {
          "const": "paused"
        },
        "reason": {
          "type": "string",
          "enum": [
            "user",
            "hidden",
            "network"
          ]
        }
      },
      "required": [
        "event_id",
        "sequence",
        "client_at",
        "type",
        "reason"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "event_id": {
          "type": "string",
          "format": "uuid"
        },
        "sequence": {
          "type": "integer",
          "minimum": 1
        },
        "client_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "type": {
          "const": "resumed"
        }
      },
      "required": [
        "event_id",
        "sequence",
        "client_at",
        "type"
      ]
    }
  ]
}
